{
  "manifest_version": 3,
  "name": "Page Source Recorder",
  "version": "1.0",
  "description": "Records accumulated page source across dynamic dropdown interactions. Use right-click to start and stop recording.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
